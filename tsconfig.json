{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2021",
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		// `node` means node10, which TypeScript 6 deprecates and 7 removes.
		// `bundler` is the correct mode for a project esbuild bundles anyway.
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowSyntheticDefaultImports": true,
		"lib": ["ES2021", "DOM"]
	},
	"include": ["src/**/*.ts"]
}
