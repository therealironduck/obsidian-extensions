{
	"name": "jordans-extensions",
	"version": "1.1.1",
	"description": "Jordan's own vault tweaks in one plugin: panels, Slack copy and unlink at cursor",
	"keywords": [],
	"license": "0-BSD",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"devDependencies": {
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.36.4",
		"@eslint/js": "^10.0.0",
		"@types/node": "^26.0.0",
		"conventional-changelog-conventionalcommits": "^10.4.1",
		"conventional-recommended-bump": "^12.1.1",
		"esbuild": "0.28.2",
		"eslint": "^10.0.0",
		"eslint-plugin-obsidianmd": "^0.5.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"oxfmt": "^0.78.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"packageManager": "bun@1.4.4"
}
